{
  "name": "n10-sports-management-monorepo",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter web --filter server --parallel run dev",
    "web": "pnpm --filter web run dev",
    "server": "pnpm --filter server run dev",
    "verify": "pnpm -r run typecheck && pnpm -r run lint && pnpm -r run test && pnpm -r run build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.25.76",
      "@types/react": "^18.3.28",
      "@types/react-dom": "^18.3.7",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.2",
      "body-parser@<2.3.0": "^2.3.0",
      "nanoid@<3.3.18": "^3.3.18",
      "postcss@<8.5.18": "^8.5.26",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/pg": "^8.18.0",
    "dotenv": "^17.3.1",
    "pg": "^8.20.0"
  }
}
