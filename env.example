# Database
DATABASE_URL="your_database_connection_string_here"

# Auth — REQUIRED. Min 32 chars. The server refuses to start on a missing,
# short, or placeholder value. Generate one with:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
JWT_SECRET=""

# Reverse-proxy hops in front of the app. 0 locally; 1 behind a single proxy
# (Render/Railway/Fly/Nginx). On Vercel it already defaults to 1 — only set this
# to override. Wrong value = every client shares one rate-limit bucket.
TRUST_PROXY="0"

# Comma-separated browser origins allowed to call the API. Leave unset in dev
# (defaults to the local ports). Set it in production:
# CORS_ORIGINS="https://n10.vercel.app"

# Initial admin account — consumed by `pnpm --filter server run seed`.
# Public /register can only ever create a PROSPECT, so the first ADMIN is
# provisioned here.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Change_Me_Str0ng!"
