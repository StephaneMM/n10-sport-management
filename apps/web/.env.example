# Cloudflare Turnstile site key (public — safe to expose in the bundle).
# When set, the public application form shows a bot check whose token the
# server verifies with TURNSTILE_SECRET_KEY. Leave unset for local dev.
# VITE_TURNSTILE_SITE_KEY=""

# Dev only: where `vite` proxies /api during `pnpm web`. Defaults to
# http://localhost:4000 (the local server). The e2e harness overrides it.
# VITE_PROXY_TARGET="http://localhost:4000"
