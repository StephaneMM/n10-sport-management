// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Look ma, no URL! The config file handles it now.
}

// ------------------------------------------------------
// ENUMS (Strict Business Rules)
// ------------------------------------------------------
enum Role {
  ADMIN
  SALES_REP
  PROSPECT
}


// ------------------------------------------------------
// CORE MODELS
// ------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  role            Role             @default(PROSPECT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // The link forward
  prospectProfile ProspectProfile? 
}

model ProspectProfile {
  id               String   @id @default(uuid())
  
  // The strict 1-to-1 link backward
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal
  firstName        String
  lastName         String
  dob              DateTime
  nationality      String
  gender           String

  // Physical & Sport
  heightCm         Float
  weightKg         Float
  verticalJumpCm   Float?
  sport            String
  positions        String[] 
  highlightLinks   String[] 

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
