// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Look ma, no URL! The config file handles it now.
}

// ------------------------------------------------------
// ENUMS (Strict Business Rules)
// ------------------------------------------------------
enum Role {
  ADMIN
  SALES_REP
  PROSPECT
  COACH
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  REJECTED
  CONVERTED
}

enum DocumentType {
  GOVERNMENT_ID
  HS_TRANSCRIPT
  HS_DIPLOMA
  BACHELOR_TRANSCRIPT
  BACHELOR_DIPLOMA
  MASTER_TRANSCRIPT
  MASTER_DIPLOMA
  DOCTORATE_TRANSCRIPT
  DOCTORATE_DIPLOMA
  OTHER
}


// ------------------------------------------------------
// CORE MODELS
// ------------------------------------------------------

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  role            Role             @default(PROSPECT)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // The link forward
  prospectProfile ProspectProfile? 
}

model Lead {
  id               String   @id @default(uuid())
  
  // Contact Info
  firstName        String
  lastName         String
  email            String
  phone            String
  country          String
  
  // Demographics & Sport
  // Mandatory — drives recruiting class and the eligibility clock. Enforced by
  // createLeadSchema on the way in and NOT NULL in the database.
  dateOfBirth      DateTime
  nationality      String
  gender           String
  sport            String
  positions        String[]
  
  // Physical
  heightCm         Float
  weightKg         Float
  verticalJumpCm   Float?
  
  // Experience
  league           String?
  currentClub      String?
  highlightLinks   String[]
  
  // Messages & Admin Notes
  messageToUs      String?  // Not mandatory
  adminComment     String?  // Admin adds this later

  // Triage state, moved by an admin as the lead is worked. Every new
  // submission starts at NEW.
  status           LeadStatus @default(NEW)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Support the admin list filters and sorts (see listLeadsQuerySchema).
  @@index([createdAt])
  @@index([sport])
  @@index([nationality])
  @@index([gender])
  @@index([country])
  @@index([status])
}


model ProspectProfile {
  id               String   @id @default(uuid())
  
  // The strict 1-to-1 link backward
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal
  firstName        String
  lastName         String
  dob              DateTime
  phoneNumber      String
  country          String
  nationality      String
  gender           String

  // Physical & Sport
  heightCm         Float
  weightKg         Float
  verticalJumpCm   Float?
  sport            String
  positions        String[] 
  highlightLinks   String[] 
  league           String?
  currentClub      String? 

// Documents uploaded
  documents        Document[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Document {
  id                String          @id @default(uuid())
  url               String
  type              DocumentType
  
  // The relational link back to the Prospect Profile
  prospectProfileId String
  prospectProfile   ProspectProfile @relation(fields: [prospectProfileId], references: [id], onDelete: Cascade)

  createdAt         DateTime        @default(now())
}
