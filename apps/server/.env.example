# Copy to apps/server/.env and fill in. The server validates this at boot and
# refuses to start on anything missing, too weak, or left as a placeholder.

# ── Required

# PostgreSQL. Locally: your Neon *development* branch, DIRECT (non-pooled) URL
# (the pooled endpoint breaks Prisma migrations). Production uses the pooled URL
# and it is set in Vercel, never here.
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Min 32 chars, not a shipped placeholder. Generate one:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
JWT_SECRET=""

# ── Required in production only 

# Comma-separated browser origins allowed to call the API. Unset locally falls
# back to the dev ports; unset in production is a boot error.
# CORS_ORIGINS="https://your-domain.vercel.app"

# ── Optional 

# development | test | production   (default: development)
# NODE_ENV="development"

# Local server port (default: 4000)
# PORT="4000"

# Reverse-proxy hops. 0 locally, 1 behind one proxy. On Vercel it already
# defaults to 1 — only set this to override.
# TRUST_PROXY="0"

# Cloudflare Turnstile secret. When set, the public lead form must pass a bot
# check. The matching site key is VITE_TURNSTILE_SITE_KEY in the web app.
# TURNSTILE_SECRET_KEY=""

# Mounts POST /api/auth/register only when exactly "true". Keep it off until
# there is a prospect portal.
# ENABLE_PUBLIC_REGISTRATION="false"

# ── Seed script only (pnpm --filter server run seed)

# The first ADMIN account. Public sign-up can only ever create a PROSPECT.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Change_Me_Str0ng!"
