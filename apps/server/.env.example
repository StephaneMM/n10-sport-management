# Copy to apps/server/.env and fill in. The server validates this at boot and
# refuses to start on anything missing, too weak, or left as a placeholder.

# ── Required

# PostgreSQL. Locally: your Neon *development* branch, DIRECT (non-pooled) URL
# (the pooled endpoint breaks Prisma migrations). Production uses the pooled URL
# and it is set in Vercel, never here.
DATABASE_URL="postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# Min 32 chars, not a shipped placeholder. Generate one:
#   node -e 'console.log(require("crypto").randomBytes(48).toString("base64"))'
JWT_SECRET=""

# ── Required in production only 

# Comma-separated browser origins allowed to call the API. Unset locally falls
# back to the dev ports; unset in production is a boot error.
# CORS_ORIGINS="https://your-domain.vercel.app"

# ── Optional 

# development | test | production   (default: development)
# NODE_ENV="development"

# Local server port (default: 4000)
# PORT="4000"

# Reverse-proxy hops. 0 locally, 1 behind one proxy. On Vercel it already
# defaults to 1 — only set this to override.
# TRUST_PROXY="0"

# Cloudflare Turnstile secret. When set, the public lead form must pass a bot
# check. The matching site key is VITE_TURNSTILE_SITE_KEY in the web app.
# TURNSTILE_SECRET_KEY=""

# Resend API key (https://resend.com). When set, every new lead is emailed to
# LEAD_NOTIFICATION_TO. Unset: no email is sent.
# RESEND_API_KEY=""

# Who receives the new-lead email (default: n10.sportsmanagement@gmail.com).
# LEAD_NOTIFICATION_TO="n10.sportsmanagement@gmail.com"

# Sender, on a domain verified in Resend. Needs no mailbox: replies go to the
# applicant. (default: N10 Website <notifications@n10-sportsmanagement.com>)
# LEAD_NOTIFICATION_FROM="N10 Website <notifications@n10-sportsmanagement.com>"

# Web app the email links to for opening the lead in the admin. Unset leaves
# the link out. Locally: http://localhost:8080. Production is set in Vercel.
# ADMIN_APP_URL="http://localhost:8080"

# Mounts POST /api/auth/register only when exactly "true". Keep it off until
# there is a prospect portal.
# ENABLE_PUBLIC_REGISTRATION="false"

# Sentry DSN for error monitoring & performance tracing
SENTRY_DSN="https://c05cc7177dd1472adef0635691039615@o4512275615186944.ingest.us.sentry.io/4512279264362496"

# ── Gemini Auto-Fix (Autonomous Agent)
# GitHub personal access token (classic or fine-grained with issues:write) to auto-create 'auto-fix' labeled issues
# AUTOFIX_GITHUB_TOKEN=ghp_your_token_here
# AUTOFIX_GITHUB_REPO=StephaneMM/n10-sport-management

# ── Seed script only (pnpm --filter server run seed)

# The first ADMIN account. Public sign-up can only ever create a PROSPECT.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Change_Me_Str0ng!"

